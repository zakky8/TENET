{
  "name": "tenet",
  "version": "0.0.0",
  "private": true,
  "description": "Verification-first, multi-surface agent platform. Community-grade to enterprise technical support.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zakky8/TENET",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakky8/TENET.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "pnpm -r lint",
    "eval": "pnpm --filter @tenet/eval run eval",
    "audit": "pnpm audit --prod --audit-level high",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "jest": "^30.4.2",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3"
  }
}
