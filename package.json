{
  "name": "tenet",
  "version": "0.0.0",
  "private": true,
  "description": "Verification-first, multi-surface agent platform. Community-grade to enterprise technical support.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/zakky8/TENET",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakky8/TENET.git"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "pnpm -r lint",
    "eval": "pnpm --filter @tenet/eval run eval",
    "audit": "pnpm audit --prod --audit-level high",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.0"
  }
}
