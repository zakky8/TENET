      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "echo 'no lint yet' && exit 0"
  },
  "keywords": [
    "agent-framework",
    "ai",
    "ai-agents",
    "durable-execution",
    "deterministic-replay",
    "human-in-the-loop",
    "langchain-alternative",
    "llm",
    "temporal-alternative",
    "tenet",
    "typescript",
    "workflow"
  ]
}
