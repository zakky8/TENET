{
  "name": "@tenet/agent",
  "version": "0.0.0",
  "description": "The verification-first agent turn — the composition root that DRIVES core's AgentState as a @tenet/workflow graph: deterministic pre-handlers -> retrieve -> a decides-and-drafts Reasoner -> fail-CLOSED verify -> critique-retry -> emit | abstain | handoff. The worst outcome of any turn is a human handoff, never an ungrounded fact.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "echo 'no lint yet' && exit 0"
  },
  "dependencies": {
    "@tenet/core": "workspace:*",
    "@tenet/governance": "workspace:*",
    "@tenet/guardrails": "workspace:*",
    "@tenet/harness": "workspace:*",
    "@tenet/refine": "workspace:*",
    "@tenet/workflow": "workspace:*"
  },
  "keywords": [
    "agent-framework",
    "ai",
    "ai-agents",
    "anti-hallucination",
    "grounded-or-abstain",
    "langchain-alternative",
    "llm",
    "orchestrator",
    "tenet",
    "typescript",
    "verification-first"
  ]
}
